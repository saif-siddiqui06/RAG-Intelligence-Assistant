# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# ==== Application ====
APP_NAME=Agentic RAG Research Assistant
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ==== Server ====
HOST=0.0.0.0
PORT=8000

# ==== CORS (JSON array of allowed origins) ====
BACKEND_CORS_ORIGINS=["http://localhost:8501"]

# ==== OpenAI — used by the document ingestion pipeline for embeddings ====
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# ==== Database — SQLite by default so ingestion works with zero extra infra.
# Swap to a postgresql:// URL later; the SQLAlchemy code doesn't change. ====
DATABASE_URL=sqlite:///./data/processed/metadata.db

# ==== RAG / ingestion ====
VECTOR_STORE_BACKEND=faiss
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ==== Storage paths (created automatically on startup) ====
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
VECTORSTORE_DIR=data/vectorstore

# ==== Logging ====
LOG_LEVEL=INFO
LOG_DIR=logs

# ==== Frontend ====
API_BASE_URL=http://localhost:8000
