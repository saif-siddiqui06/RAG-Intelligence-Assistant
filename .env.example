# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit real secrets.

# ==== Application ====
APP_NAME=Agentic RAG Research Assistant
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ==== Server ====
HOST=0.0.0.0
PORT=8000

# ==== CORS (JSON array of allowed origins) ====
BACKEND_CORS_ORIGINS=["http://localhost:8501"]

# ==== Gemini (Google AI Studio) — used for embeddings, query rewriting and
# answer generation. Free tier, no credit card required:
# https://aistudio.google.com/apikey ====
GEMINI_API_KEY=your-gemini-key-here
GEMINI_MODEL=gemini-3.6-flash
EMBEDDING_MODEL=gemini-embedding-2

# ==== Database — SQLite by default so ingestion works with zero extra infra.
# Under docker-compose this is overridden to point at the `db` Postgres
# service (see docker-compose.yml); the SQLAlchemy code doesn't change
# either way. ====
DATABASE_URL=sqlite:///./data/processed/metadata.db
# Used by docker-compose to configure the `db` service and build the
# DATABASE_URL above when running in Docker.
POSTGRES_USER=rag
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rag

# ==== RAG / ingestion ====
VECTOR_STORE_BACKEND=faiss
CHUNK_SIZE=1000
CHUNK_OVERLAP=150

# ==== RAG / retrieval & chat (vector-only mode) ====
RETRIEVAL_TOP_K=5
RETRIEVAL_OVERFETCH_MULTIPLIER=4
MIN_RELEVANCE_SCORE=0.15
DEDUP_SIMILARITY_THRESHOLD=0.9
CONVERSATION_HISTORY_WINDOW=6
CONFIDENCE_HIGH_THRESHOLD=0.5
CONFIDENCE_MEDIUM_THRESHOLD=0.3

# ==== RAG / hybrid retrieval ====
# "vector" = unchanged Milestone 2 path. "hybrid" = vector + BM25 + fusion + reranking.
RETRIEVAL_MODE=vector
VECTOR_TOP_K=20
BM25_TOP_K=20
RERANK_TOP_K=10
FINAL_CONTEXT_K=5
RRF_K=60
# "cross_encoder" (local model, no API key) or "none" (passthrough).
RERANKER_BACKEND=cross_encoder
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ==== Agent ====
AGENT_MAX_ITERATIONS=5
AGENT_TOOL_TIMEOUT_SECONDS=20.0
WEB_SEARCH_MAX_RESULTS=5
SUMMARY_MAX_CHARS=12000

# ==== Storage paths (created automatically on startup) ====
UPLOAD_DIR=data/uploads
PROCESSED_DIR=data/processed
VECTORSTORE_DIR=data/vectorstore

# ==== Logging ====
LOG_LEVEL=INFO
LOG_DIR=logs
# "text" for local dev, "json" for production log aggregators.
LOG_FORMAT=text

# ==== Production hardening ====
MAX_UPLOAD_SIZE_MB=25
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_EVALUATION=3/hour

# ==== Frontend ====
# Overridden to http://backend:8000 by docker-compose.
API_BASE_URL=http://localhost:8000
